---
import Layout from "../../layouts/Layout.astro";
const groups=[{value:4,count:5,color:"#67e0bd"},{value:6,count:5,color:"#8da9ff"},{value:8,count:5,color:"#ffca58"}];
---
<Layout title="Régressions filtrées — TP2" description="Choisir une catégorie de voitures pour afficher sa régression."><main id="contenu" class="mx-auto min-h-screen w-full max-w-[1240px] px-[clamp(1.25rem,5vw,4rem)] py-6"><nav class="flex justify-between text-xs uppercase"><a class="text-mist no-underline" href="/autres-graphiques">← Autres graphiques</a><a class="text-mist no-underline" href="/examples/Waffle">Waffle →</a></nav><header class="grid min-h-[55vh] content-center py-16"><p class="text-xs font-bold tracking-[.2em] text-mint uppercase">Régression · Une page par filtre</p><h1 class="m-0 font-serif text-[clamp(3.8rem,9vw,8rem)] font-normal leading-none">Choisir le nombre<br /><em class="text-mint">de cylindres.</em></h1></header><section class="grid gap-4 border-t border-[#29404b] py-16 md:grid-cols-3">{groups.map((group)=><a href={`/regression/${group.value}`} class="group flex min-h-[300px] flex-col rounded-2xl border border-[#29404b] bg-panel p-7 text-white no-underline transition hover:-translate-y-2 hover:border-mint"><span class="text-xs text-[#8fa8af]">{group.count} MODÈLES</span><strong class="my-auto font-serif text-6xl font-normal" style={`color:${group.color}`}>{group.value}</strong><span class="text-mist">cylindres</span><span class="mt-5 self-end text-2xl text-mint">→</span></a>)}</section></main></Layout>
