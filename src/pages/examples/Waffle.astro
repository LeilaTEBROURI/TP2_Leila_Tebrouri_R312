---
import * as Plot from "@observablehq/plot";
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
const survey = [{answer:"Oui",count:63},{answer:"Peut-être",count:24},{answer:"Non",count:13}];
const options = {
  width:820,height:500,marginTop:80,marginBottom:35,
  ariaLabel:"Grille de cent carrés représentant les réponses de cent étudiants à un sondage.",
  color:{legend:true,domain:["Oui","Peut-être","Non"],range:["#67e0bd","#8da9ff","#ffca58"],label:"Réponse"},
  y:{axis:null},
  marks:[Plot.waffleY(survey,{y:"count",fill:"answer",multiple:10,gap:2,tip:true,title:(d)=>`${d.answer} : ${d.count} %`})],
};
---
<Layout title="Survey Waffle — TP2" description="Un sondage de cent réponses représenté avec un waffle chart.">
  <main id="contenu" class="mx-auto min-h-screen w-full max-w-[1240px] px-[clamp(1.25rem,5vw,4rem)] py-6">
    <nav class="flex items-center justify-between text-xs tracking-[.14em] uppercase" aria-label="Navigation entre les exemples">
      <a class="text-mist no-underline hover:text-mint" href="/autres-graphiques">← Autres graphiques</a>
      <a class="rounded-full border border-[#36505b] px-4 py-2 text-mist no-underline hover:border-mint hover:text-mint" href="/examples/Simpson">Simpson →</a>
    </nav>
    <header class="grid min-h-[46vh] content-center py-16"><p class="mb-4 text-xs font-bold tracking-[.2em] text-mint uppercase">02 · Sondage</p><h1 class="m-0 max-w-[900px] font-serif text-[clamp(3.6rem,8vw,7rem)] leading-[.95] font-normal tracking-[-.055em]">Cent réponses.<br /><em class="font-normal text-mint">Case par case.</em></h1></header>
    <section class="grid gap-10 border-t border-[#29404b] py-[clamp(4rem,8vw,7rem)] lg:grid-cols-[.65fr_1.5fr]" aria-labelledby="plot-title">
      <div><p class="text-xs font-bold tracking-[.18em] text-mint uppercase">Waffle chart</p><h2 id="plot-title" class="font-serif text-[clamp(2.3rem,4vw,4rem)] leading-none font-normal">Une personne, une case</h2><p id="plot-desc" class="leading-relaxed text-mist">Chaque carré correspond à une réponse. Les couleurs permettent de comparer rapidement Oui, Peut-être et Non.</p></div>
      <figure class="m-0 rounded-2xl border border-[#29404b] bg-[rgba(10,37,52,.72)] p-[clamp(1rem,2.2vw,2rem)]"><PlotFigure options={options} labelledby="plot-title" describedby="plot-desc" /><figcaption class="mt-5 border-t border-[#29404b] pt-4 text-xs text-[#8fa8af]">Sondage fictif de 100 étudiants réalisé avec Plot.waffleY.</figcaption></figure>
    </section>
    <footer class="flex justify-between gap-3 border-t border-[#29404b] py-8 text-xs text-[#78909c]"><p>TP_Dev_Front_integration</p><p>Leila_Tebrouri_MMI2_B1</p></footer>
  </main>
</Layout>
