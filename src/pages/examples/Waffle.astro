---
import Layout from "../../layouts/Layout.astro";
const topics=[{slug:"developpement-web",label:"Développement web",color:"#67e0bd"},{slug:"design-interface",label:"Design d’interface",color:"#8da9ff"},{slug:"datavisualisation",label:"Datavisualisation",color:"#ffca58"}];
---
<Layout title="Waffles filtrés — TP2" description="Choisir une question pour afficher son waffle chart."><main id="contenu" class="mx-auto min-h-screen w-full max-w-[1240px] px-[clamp(1.25rem,5vw,4rem)] py-6"><nav class="flex justify-between text-xs uppercase"><a class="text-mist no-underline" href="/autres-graphiques">← Autres graphiques</a><a class="text-mist no-underline" href="/examples/Regression">Régression →</a></nav><header class="grid min-h-[55vh] content-center py-16"><p class="text-xs font-bold tracking-[.2em] text-mint uppercase">Waffle · Une page par filtre</p><h1 class="m-0 font-serif text-[clamp(3.8rem,9vw,8rem)] font-normal leading-none">Choisir une<br /><em class="text-mint">question.</em></h1></header><section class="grid gap-4 border-t border-[#29404b] py-16 md:grid-cols-3">{topics.map((topic)=><a href={`/waffle/${topic.slug}`} class="group min-w-0 flex min-h-[300px] flex-col rounded-2xl border border-[#29404b] bg-panel p-7 text-white no-underline transition hover:-translate-y-2 hover:border-mint"><span class="text-xs text-[#8fa8af]">100 RÉPONSES</span><strong class="my-auto font-serif text-[clamp(1.7rem,2.8vw,3rem)] font-normal leading-[1.05] [overflow-wrap:anywhere]" style={`color:${topic.color}`}>{topic.label}</strong><span class="mt-5 self-end text-2xl text-mint">→</span></a>)}</section></main></Layout>
