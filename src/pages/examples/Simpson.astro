---
import * as Plot from "@observablehq/plot";
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
const results = [
  {hours:1,score:62,group:"Groupe A"},{hours:2,score:66,group:"Groupe A"},{hours:3,score:69,group:"Groupe A"},{hours:4,score:73,group:"Groupe A"},{hours:5,score:77,group:"Groupe A"},{hours:6,score:80,group:"Groupe A"},
  {hours:5,score:38,group:"Groupe B"},{hours:6,score:42,group:"Groupe B"},{hours:7,score:46,group:"Groupe B"},{hours:8,score:50,group:"Groupe B"},{hours:9,score:54,group:"Groupe B"},{hours:10,score:58,group:"Groupe B"},
];
const options = {
  width: 820, height: 500, marginLeft: 58, marginBottom: 54,
  ariaLabel: "Nuage de points et régressions linéaires des résultats de deux groupes d’étudiants.",
  color: {legend:true,domain:["Groupe A","Groupe B"],range:["#67e0bd","#ffca58"],label:"Groupe"},
  x: {label:"Heures de révision →",grid:true}, y: {label:"↑ Score obtenu",grid:true},
  marks: [
    Plot.frame({stroke:"#55717a"}),
    Plot.dot(results,{x:"hours",y:"score",fill:"group",r:7,tip:true}),
    Plot.linearRegressionY(results,{x:"hours",y:"score",stroke:"group",strokeWidth:2}),
    Plot.linearRegressionY(results,{x:"hours",y:"score",stroke:"#dfecef",strokeDasharray:"5,5"}),
  ],
};
---
<Layout title="Régression de Simpson — TP2" description="Exemple de régression linéaire inspiré du paradoxe de Simpson.">
  <main id="contenu" class="mx-auto min-h-screen w-full max-w-[1240px] px-[clamp(1.25rem,5vw,4rem)] py-6">
    <nav class="flex items-center justify-between text-xs tracking-[.14em] uppercase" aria-label="Navigation entre les exemples">
      <a class="text-mist no-underline hover:text-mint" href="/autres-graphiques">← Autres graphiques</a>
      <a class="rounded-full border border-[#36505b] px-4 py-2 text-mist no-underline hover:border-mint hover:text-mint" href="/examples/Waffle">Waffle →</a>
    </nav>
    <header class="grid min-h-[46vh] content-center py-16"><p class="mb-4 text-xs font-bold tracking-[.2em] text-mint uppercase">01 · Régression</p><h1 class="m-0 max-w-[900px] font-serif text-[clamp(3.6rem,8vw,7rem)] leading-[.95] font-normal tracking-[-.055em]">Une tendance peut<br /><em class="font-normal text-mint">en cacher une autre.</em></h1></header>
    <section class="grid gap-10 border-t border-[#29404b] py-[clamp(4rem,8vw,7rem)] lg:grid-cols-[.65fr_1.5fr]" aria-labelledby="plot-title">
      <div><p class="text-xs font-bold tracking-[.18em] text-mint uppercase">Paradoxe de Simpson</p><h2 id="plot-title" class="font-serif text-[clamp(2.3rem,4vw,4rem)] leading-none font-normal">Comparer les groupes</h2><p id="plot-desc" class="leading-relaxed text-mist">Les lignes colorées montrent les tendances de chaque groupe. La ligne blanche en pointillés montre la tendance globale.</p></div>
      <figure class="m-0 rounded-2xl border border-[#29404b] bg-[rgba(10,37,52,.72)] p-[clamp(1rem,2.2vw,2rem)]"><PlotFigure options={options} labelledby="plot-title" describedby="plot-desc" /><figcaption class="mt-5 border-t border-[#29404b] pt-4 text-xs text-[#8fa8af]">Données pédagogiques fictives inspirées du paradoxe de Simpson.</figcaption></figure>
    </section>
    <footer class="flex justify-between gap-3 border-t border-[#29404b] py-8 text-xs text-[#78909c]"><p>TP_Dev_Front_integration</p><p>Leila_Tebrouri_MMI2_B1</p></footer>
  </main>
</Layout>
