---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Navigation par iframe — Palmer Penguins" description="Comparaison des pages espèces dans une iframe accessible.">
  <main>
    <a class="back" href="/">← Retour à l’accueil</a>
    <header>
      <p class="eyebrow">TP2 · MÉTHODE 02</p>
      <h1>Une fenêtre,<br /><em>trois espèces.</em></h1>
      <p>Les liens chargent les pages réalisées précédemment dans la même iframe, sans quitter cette page.</p>
    </header>

    <nav aria-label="Espèce affichée dans l’iframe">
      <a class="frame-link active" href="/species/Adelie" target="species-frame" data-species="Adelie">Adelie</a>
      <a class="frame-link" href="/species/Gentoo" target="species-frame" data-species="Gentoo">Gentoo</a>
      <a class="frame-link" href="/species/Chinstrap" target="species-frame" data-species="Chinstrap">Chinstrap</a>
    </nav>

    <iframe
      src="/species/Adelie"
      name="species-frame"
      title="Graphique de l’espèce sélectionnée"
      loading="eager"
    ></iframe>
  </main>
</Layout>

<script>
  const frameLinks = document.querySelectorAll<HTMLAnchorElement>(".frame-link");

  frameLinks.forEach((link) => {
    link.addEventListener("click", () => {
      frameLinks.forEach((item) => item.classList.remove("active"));
      link.classList.add("active");
    });
  });
</script>

<style>
  main { width: min(1180px, calc(100% - 2.5rem)); margin-inline: auto; padding-block: 2rem 5rem; }
  .back { display: inline-block; margin-bottom: clamp(3rem, 8vw, 7rem); color: #b8cad0; text-decoration: none; }
  header { max-width: 760px; }
  .eyebrow { color: #67e0bd; font-size: .75rem; font-weight: 750; letter-spacing: .18em; }
  h1 { margin: .8rem 0 1.5rem; font: 400 clamp(3.5rem, 8vw, 7rem)/.96 Georgia, serif; letter-spacing: -.05em; }
  h1 em { color: #67e0bd; font-weight: 400; }
  header > p:last-child { color: #b8cad0; line-height: 1.7; font-size: 1.08rem; }
  nav { display: flex; gap: .65rem; padding: 3rem 0 1.25rem; border-top: 1px solid #29404b; margin-top: 4rem; }
  nav a { padding: .7rem 1.1rem; border: 1px solid #36505b; border-radius: 999px; color: #b8cad0; text-decoration: none; }
  nav a:hover, nav a.active { color: #061724; background: #67e0bd; border-color: #67e0bd; }
  iframe { width: 100%; height: min(760px, 78vh); border: 1px solid #36505b; border-radius: 1rem; background: #061724; }
  @media (max-width: 580px) { nav { flex-wrap: wrap; } iframe { height: 700px; } }
</style>
