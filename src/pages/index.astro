---
import Layout from "../layouts/Layout.astro";
import penguins from "../data/penguins.json";

const species = [
  { name: "Adelie", color: "#67e0bd", number: "01", description: "La plus représentée dans notre échantillon." },
  { name: "Gentoo", color: "#8da9ff", number: "02", description: "La plus massive, aux longues nageoires." },
  { name: "Chinstrap", color: "#ffca58", number: "03", description: "Reconnaissable à son fin bandeau noir." },
];
---

<Layout title="TP2 — Palmer Penguins" description="Navigation entre les graphiques des trois espèces de manchots Palmer.">
  <main id="contenu" class="mx-auto min-h-screen w-full max-w-[1240px] px-[clamp(1.25rem,5vw,4rem)] py-6">
    <nav class="flex items-center justify-between text-xs tracking-[.14em] uppercase" aria-label="Navigation principale">
      <a class="grid size-10 place-items-center rounded-full border border-mint font-serif text-xl font-bold no-underline" href="/" aria-label="Accueil du TP2">P.</a>
      <a class="text-mist no-underline hover:text-mint" href="/slider">Voir le slider →</a>
      <a class="text-mist no-underline hover:text-mint" href="/autres-graphiques">Autres graphiques →</a>
    </nav>

    <header class="grid min-h-[62vh] content-center py-20">
      <p class="mb-4 text-xs font-bold tracking-[.2em] text-mint uppercase">TP2 · Développement Front &amp; Intégration</p>
      <h1 class="m-0 max-w-[960px] font-serif text-[clamp(3.8rem,9vw,8rem)] leading-[.95] font-normal tracking-[-.055em]">Trois espèces.<br /><em class="font-normal text-mint">Trois regards.</em></h1>
      <div class="mt-10 flex flex-wrap items-end justify-between gap-8 border-t border-[#29404b] pt-6">
        <p class="max-w-[590px] text-[clamp(1rem,2vw,1.2rem)] leading-relaxed text-mist">Explorez séparément les mensurations de {penguins.length} manchots Palmer, puis comparez les trois graphiques dans un slider à ancres.</p>
        <p class="font-serif text-5xl text-white">{penguins.length}</p>
      </div>
    </header>

    <section class="border-t border-[#29404b] py-[clamp(4rem,8vw,7rem)]" aria-labelledby="species-title">
      <p class="mb-3 text-xs font-bold tracking-[.18em] text-mint uppercase">01 · Une page par graphique</p>
      <h2 id="species-title" class="mb-12 font-serif text-[clamp(2.6rem,5vw,4.8rem)] leading-none font-normal tracking-[-.045em]">Choisir une espèce</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {species.map((item) => (
          <a href={`/species/${item.name}`} class="group flex min-h-[300px] flex-col rounded-2xl border border-[#29404b] bg-panel p-6 text-white no-underline transition duration-300 hover:-translate-y-2 hover:border-mint">
            <span class="text-xs tracking-[.18em] text-[#8fa8af]">{item.number}</span>
            <span class="my-auto font-serif text-[clamp(2.4rem,4vw,4rem)] tracking-[-.04em]" style={`color:${item.color}`}>{item.name}</span>
            <span class="max-w-[15rem] text-sm leading-relaxed text-mist">{item.description}</span>
            <span class="mt-5 self-end text-2xl text-mint transition group-hover:translate-x-1" aria-hidden="true">→</span>
          </a>
        ))}
      </div>
    </section>

    <section class="grid gap-8 border-t border-[#29404b] py-[clamp(4rem,8vw,7rem)] md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="mb-3 text-xs font-bold tracking-[.18em] text-mint uppercase">02 · Une page avec ancres</p>
        <h2 class="m-0 max-w-[700px] font-serif text-[clamp(2.6rem,5vw,4.8rem)] leading-none font-normal tracking-[-.045em]">Comparer dans un slider horizontal.</h2>
      </div>
      <a href="/slider" class="inline-flex rounded-full bg-mint px-6 py-4 font-bold text-ink no-underline hover:bg-[#a4f2dc]">Ouvrir le slider →</a>
    </section>

    <section class="grid gap-8 border-t border-[#29404b] py-[clamp(4rem,8vw,7rem)] md:grid-cols-[1fr_auto] md:items-end">
      <div>
        <p class="mb-3 text-xs font-bold tracking-[.18em] text-mint uppercase">03 · Autres exemples</p>
        <h2 class="m-0 max-w-[700px] font-serif text-[clamp(2.6rem,5vw,4.8rem)] leading-none font-normal tracking-[-.045em]">Regression et waffle sur une page dédiée.</h2>
      </div>
      <a href="/autres-graphiques" class="inline-flex rounded-full bg-mint px-6 py-4 font-bold text-ink no-underline hover:bg-[#a4f2dc]">Voir les deux graphiques →</a>
    </section>

    <footer class="flex flex-col justify-between gap-2 border-t border-[#29404b] py-8 text-xs tracking-[.08em] text-[#78909c] uppercase sm:flex-row">
      <p>TP_Dev_Front_integration</p>
      <p>Leila_Tebrouri_MMI2_B1</p>
    </footer>
  </main>
</Layout>
