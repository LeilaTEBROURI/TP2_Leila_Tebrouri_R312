---
import * as Plot from "@observablehq/plot";
import Layout from "../../layouts/Layout.astro";
import PlotFigure from "../../components/PlotFigure.astro";
import survey from "../../data/survey.json";
const topics=[{slug:"developpement-web",label:"Développement web"},{slug:"design-interface",label:"Design d’interface"},{slug:"datavisualisation",label:"Datavisualisation"}];
export function getStaticPaths(){const paths=[{slug:"developpement-web",label:"Développement web"},{slug:"design-interface",label:"Design d’interface"},{slug:"datavisualisation",label:"Datavisualisation"}];return paths.map((topic)=>({params:{topic:topic.slug},props:{topic}}));}
const { topic }=Astro.props;
const filteredSurvey=survey.filter((answer)=>answer.topic===topic.slug);
const options={width:820,height:500,marginTop:75,marginBottom:35,ariaLabel:`Réponses filtrées pour ${topic.label}.`,color:{legend:true,domain:["Oui","Peut-être","Non"],range:["#67e0bd","#8da9ff","#ffca58"],label:"Réponse"},y:{axis:null},marks:[Plot.waffleY(filteredSurvey,{y:"count",fill:"answer",multiple:10,gap:2,tip:true,title:(d)=>`${d.answer} : ${d.count} %`})]};
---
<Layout title={`${topic.label} — Waffle`} description={`Sondage filtré sur ${topic.label}.`}><main id="contenu" class="mx-auto min-h-screen w-full max-w-[1240px] px-[clamp(1.25rem,5vw,4rem)] py-6"><nav class="flex flex-wrap items-center justify-between gap-4 text-xs uppercase"><a class="text-mist no-underline" href="/examples/Waffle">← Waffle</a><div class="flex flex-wrap gap-2">{topics.map((item)=><a class:list={["rounded-full border px-4 py-2 no-underline",item.slug===topic.slug?"border-mint bg-mint text-ink":"border-[#36505b] text-mist"]} href={`/waffle/${item.slug}`}>{item.label}</a>)}</div></nav><header class="grid min-h-[42vh] content-center py-16"><p class="text-xs font-bold tracking-[.2em] text-mint uppercase">Filtre · 100 réponses</p><h1 class="m-0 font-serif text-[clamp(3.6rem,8vw,7rem)] font-normal leading-none">Sondage <em class="text-mint">{topic.label}.</em></h1></header><section class="grid gap-10 border-t border-[#29404b] py-16 lg:grid-cols-[.65fr_1.5fr]" aria-labelledby="plot-title"><div><h2 id="plot-title" class="font-serif text-5xl font-normal">Une réponse, une case</h2><p id="plot-desc" class="leading-relaxed text-mist">Le tableau du sondage a été filtré avec <code>survey.filter()</code> pour ne conserver que la question « {topic.label} ».</p></div><figure class="m-0 rounded-2xl border border-[#29404b] bg-panel p-6"><PlotFigure options={options} labelledby="plot-title" describedby="plot-desc" /><figcaption class="mt-5 border-t border-[#29404b] pt-4 text-xs text-[#8fa8af]">Oui, Peut-être et Non sur un total de 100 réponses.</figcaption></figure></section></main></Layout>
