---
import "../styles/global.css";

const {
  title = "Les manchots Palmer avec Observable Plot",
  description = "Visualisations de données réalisées avec Astro et Observable Plot.",
} = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#071b2e" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#contenu">Aller au contenu</a>
    <slot />
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    background: #061724;
    color: #ecf5f7;
    font-synthesis: none;
  }

  * { box-sizing: border-box; }

  body {
    margin: 0;
    min-width: 320px;
    background:
      radial-gradient(circle at 12% 8%, rgba(51, 214, 166, 0.14), transparent 28rem),
      radial-gradient(circle at 88% 26%, rgba(91, 155, 255, 0.13), transparent 26rem),
      #061724;
  }

  a { color: #67e0bd; }
  a:hover { color: #a4f2dc; }
  :focus-visible { outline: 3px solid #ffd166; outline-offset: 4px; }

  .skip-link {
    position: fixed;
    z-index: 10;
    left: 1rem;
    top: 1rem;
    padding: .75rem 1rem;
    border-radius: .5rem;
    background: #fff;
    color: #071b2e;
    transform: translateY(-180%);
  }
  .skip-link:focus { transform: translateY(0); }

  .plot text { fill: #dfecef; }
  .plot .domain, .plot .tick line { stroke: #78909c; }
  .plot figcaption { color: #b8cad0; }

  @media (prefers-reduced-motion: reduce) {
    *, *::before, *::after { scroll-behavior: auto !important; }
  }
</style>
